# setup/versions.env — tek sürüm kaynağı; ortam kilidi (FR-31).
# Bash'ten `source` edilir. Sürümler yalnız burada tanımlanır; betiklerde sabit yazılmaz.
# Kaynak: proje el kitabı (Simülasyon ve Uçuş Katmanı, Çalışma Takvimi) ve GŞÖA 5.3 (yazılım arayüzleri).
REQUIRED_UBUNTU="24.04"
ROS_DISTRO="jazzy"
GZ_RELEASE="harmonic"
# Gazebo apt paket adlarındaki ANA SÜRÜM ekleri (gz-<release> adı GZ_RELEASE'ten türer; libgz-sim<N>-dev, python3-gz-transport<N>, python3-gz-msgs<N> adları sürüm ekli olduğundan burada tutulur)
GZ_SIM_MAJOR="8"
GZ_TRANSPORT_MAJOR="13"
GZ_MSGS_MAJOR="10"
# NOT: Gazebo ana sürüm numaraları Python içe aktarma adlarında (gz.transport13, gz.msgs10) ve pkg-config/CMake adlarında (gz-sim8, gz-rendering8, gz-transport13, gz-msgs10, gz-plugin2)
# bilinçli olarak kodda sabit kalır: bunlar paket değil, kitaplığın kendi modül adlarıdır ve sürümle birlikte değişir; değişken olarak üretilemezler. Gazebo sürümü değişirse (GZ_RELEASE ve yukarıdaki
# *_MAJOR anahtarları ile birlikte) şu yerler elle güncellenir: araclar/{alan_pilot_olcum,arac_kimlik_testi,kamera_gorus_deneme,kamera_olcum,koordinator_deneme,px4_adapter_deneme,yuk_olcum}.py,
# src/swarm_gcs/swarm_gcs/gorev_koordinatoru.py, src/swarm_vehicle/swarm_vehicle/{arac,kamera_alici_gz}.py, src/yayim_damga/CMakeLists.txt, setup/{20_gazebo_harmonic,30_px4_sitl,runtime_smoke}.sh,
# setup/{arac_kimlik,kamera_olcum,px4_adapter,yayim_olcum,yuk_olcum}_testi.sh (apt_kilit_testi.sh'deki gz-harmonic/ros-jazzy metinleri test verisidir, güncellenmez).
PX4_TAG="v1.16.0"
PYTHON_REQUIRED="3.12"
TORCH_VERSION="2.15.0"
TORCH_CUDA_TAG="cu132"
TORCHVISION_VERSION="0.29.2"
ULTRALYTICS_VERSION="8.4.210"
MAVSDK_VERSION="3.17.4"
ONNXRUNTIME_VERSION="1.31.1"
# ONNX dışa aktarımı (Ultralytics export(format='onnx') onnx ve varsayılan simplify için onnxslim ister)
ONNX_VERSION="1.23.2"
ONNXSLIM_VERSION="0.1.99"
NUMPY_VERSION="2.5.4"
SCIPY_VERSION="1.18.1"
# Ön kontrol eşikleri
CUDA_MIN="13.2"
MIN_RAM_GIB="28"
MIN_FREE_DISK_GIB="100"
# ROS 2 apt kaynağı paketi (ros2-apt-source) — sürüm ve SHA-256 kilitli
ROS_APT_SOURCE_VERSION="1.3.0"
ROS_APT_SOURCE_SHA256="f31d84adf5054c7d60ded0e82c0f776a77ea33af53d08f40b9ad7c94cca55296"
# Gazebo (OSRF deposu) anahtarı — URL ve SHA-256 kilitli
GZ_OSRF_KEY_URL="https://packages.osrfoundation.org/gazebo.gpg"
GZ_OSRF_KEY_SHA256="15d0300460e0c9c0efb21fa9770c0bf228988a07d71c4fac985c2161954a25a4"

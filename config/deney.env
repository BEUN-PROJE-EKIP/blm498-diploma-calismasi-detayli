# config/deney.env — deney yapılandırmasının TEK KAYNAĞI (GŞÖA 5.1: "portlar, kimlikler ve deney ayarları tek yapılandırma dosyasında").
# Bash'ten `source` edilir. Ağ sabitleri yalnız burada tanımlanır; betiklerde ve kodda sabit yazılmaz.
# Bu sürümde yalnız ağ ve port bölümü vardır; ileride genişler.

# Ölçülen sürü ağı (loopback üzerinde ayrılmış blok)
SWARM_NET="10.10.0.0/24"
UAV1_ADDR="10.10.0.1"
UAV2_ADDR="10.10.0.2"
UAV3_ADDR="10.10.0.3"
GCS_ADDR="10.10.0.10"

# Fast DDS varsayılan keşif çoklu yayın grubu. Profille kapatılamıyor (alıcı yok, yalnız gönderim var); bu yüzden sınırlayıcıya
# (1:10) alınır ve keşif duyuruları da D sayacına girer. Belgedeki "çoklu yayın kullanılmaz" ifadesinden bilinen bir sapmadır.
DDS_MCAST_ADDR="239.255.0.1"

# Ortak kapasite sınırlayıcı (deneysel varsayım, sonuçlara bakılarak DEĞİŞTİRİLMEZ)
LINK_RATE_MBIT="25"

# Sınırlayıcı kuyruğu (FIFO, bayt). PROTOKOL PARAMETRESİ: el kitabındaki öngörülen başlangıç değeri (4 MiB, 25 Mbit/s'de ≈ 1,3 sn bekleme);
# kesin değer ayar pilotunda belirlenir ve ana deneyden önce kilitlenir.
LINK_QUEUE_BYTES="4194304"

# 127.0.0.1 üzerinde kalan iç bağlantılar (sınırlayıcıdan geçmez)
PX4_MAVLINK_PORTS="14540 14541 14542"
MAVSDK_GRPC_PORTS="50051 50052 50053"

# Araç kimlikleri, ad alanları ve başlangıç konumları (araç sırası: 1. değer = 1. araç). Sıra, PX4_MAVLINK_PORTS ve MAVSDK_GRPC_PORTS ile aynıdır.
# Eşleme tablosu:
#   araç   MAV_SYS_ID   PX4→MAVSDK UDP   mavsdk_server gRPC   ROS 2 ad alanı   PX4 örneği (-i)   başlangıç konumu (x,y,z m)
#   1      1            14540            50051                /uav_1           0                 UAV_START_POSES 1. değer
#   2      2            14541            50052                /uav_2           1                 UAV_START_POSES 2. değer
#   3      3            14542            50053                /uav_3           2                 UAV_START_POSES 3. değer
# PX4 SITL kuralları: MAV_SYS_ID = örnek+1, UDP = 14540+örnek (PX4 üzerinde değiştirilmez; test bunu doğrular).
UAV_SYS_IDS="1 2 3"
UAV_NAMESPACES="uav_1 uav_2 uav_3"
UAV_START_POSES="0,0,0 3,0,0 6,0,0"

# Simülasyon dünyası ve araç modeli (başsız Gazebo, PX4 SITL)
SIM_WORLD="default"
SIM_MODEL="gz_x500_mono_cam_down"

# Kamera ve deneme sahnesi (damga/sıra ve görüş açısı ölçümleri). Kamera araç gövdesine sabit ve aşağı bakan olacak (belge);
# deneme sahnesinde 30 m'de duran sabit kamera modeli kullanılır (araclar/kamera_olcum.py sahneyi bu değerlerden üretir).
CAM_WIDTH="640"
CAM_HEIGHT="480"
CAM_RATE_HZ="2"
CAM_ALT_M="30"
# SDF'deki yatay görüş açısı (rad): PX4'ün aşağı bakan kamera modeli (x500_mono_cam_down) ile aynı değer. Deneme sahnesinin girdisidir,
# protokol kilidi DEĞİL; kilitlenecek değer K10 ölçümüyle belirlenir.
CAM_SDF_HFOV_RAD="1.74"
# KİLİTLİ yatay görüş açısı (kullanıcı kararı): 65° (65°·π/180 = 1,134464 rad). Dayanak: aday açılarda (65°, 67,5°, 70°) yatan insanın dar kenarı
# ölçümü; 65°'de en kötü durum dar kenar 8,22 piksel (≥ 8 piksel kabul ölçütü). Sonuçlara bakılarak değiştirilmez. CAM_SDF_HFOV_RAD (1,74) yalnız
# ölçüm betiklerinde karşılaştırma tabanı olarak kalır; HFOV_ADAY_DERECE aday ölçümleri içindir.
CAM_HFOV_DEG="65"
CAM_HFOV_RAD="1.134464"
CAM_WORLD="kamera"
# Yerdeki hedefler: "kenar_m:x_m:y_m" (kamera 0,0 noktasının tam üstünde; görüntünün yatay ekseni dünya y eksenidir)
CAM_TARGETS="1:0:0 2:0:20 4:-10:-25"
# Çok kameralı yük denemesinde kameralar y ekseninde bu aralıkla dizilir
CAM_SPACING_M="100"
# Ölçüm süreleri (simülasyon saniyesi): K9 ≥ 600 kare için 2 Hz'de ≥ 300 sn; yük altı ≥ 120 sn
CAM_K9_SIM_SN="320"
CAM_YUK_SIM_SN="130"

# Yük ölçümü (üç araç + üç kamera + üç çıkarım işçisi) ve çıkarım ayarları. Çıkarım ayarları KİLİTLİDİR; sonuçlara bakılarak değiştirilmez.
INF_CONF="0.25"
INF_NMS="False"
INF_MAX_DET="300"
INF_IMGSZ="640"
INF_BATCH="1"
INF_PRECISION="fp32"
# Model ağırlıkları depoya girmez (.generated/models/, SHA-256 listesiyle izlenir)
INF_GPU_MODEL=".generated/models/yolo26l.pt"
INF_CPU_MODEL=".generated/models/yolo26s.pt"
# Süreler: gerçek hızda sürekli koşu (sim sn, ≥ 5 dk), doygunluk testi (gerçek sn)
YUK_SIM_SN="320"
YUK_DOYGUNLUK_SN="60"
# İşçi başına sınırlı kare kuyruğu (basit; taşma sayılır). Nihai kuyruk sınırı ayar pilotunda belirlenir.
YUK_KUYRUK="4"
# CPU yolu (ONNX Runtime): işçi başına mantıksal CPU sayısı = intra_op_num_threads
YUK_CPU_ISCI_CPU="2"
# CPU yolu (ONNX Runtime) gerçek hızda sürekli koşu süresi (sim sn)
YUK_CPU_SIM_SN="130"

# Aday yatay görüş açıları (derece) ve hedef boyutu ölçümü (GŞÖA 5.2). Kabul ölçütü ölçülmüş değer değildir: yatan insanın dar kenarı ≥ OLC_DAR_KENAR_PX piksel.
HFOV_ADAY_DERECE="65 67.5 70"
OLC_DAR_KENAR_PX="8"
# Yatan insan (ölçüm temsili, kalıcı model değil): uzun kenar:dar kenar:kalınlık (m); yönelim görüntü yatay eksenine göre (derece)
INSAN_BOYUT="1.7:0.5:0.25"
INSAN_YONELIM="0 45 90"
# Enkaz yığını (ölçüm temsili): kutu sayısı, yığın çapı (m), en büyük kutu yüksekliği (m)
ENKAZ_KUTU_SAYISI="6"
ENKAZ_CAP_M="3"
ENKAZ_YUKSEKLIK_M="0.9"
# HFOV kalibrasyon levhaları (kenar_m:görüntü_yarı_genişliğinin_oranı_x:oranı_y); konumlar her adayın görüş alanına göre ölçeklenir
KALIB_KARELER="1:-0.5:-0.5 2:-0.5:0.5 4:0.4:0"

# Eğitim bellek denemesi (belge: 50 epoch, batch=16, 640 piksel, nms=False, save_period=1). Bu ayarlar eğitim DENEMESİ içindir; gerçek eğitim ayrı karttır.
TRAIN_MODEL=".generated/models/yolo26l.pt"
TRAIN_IMGSZ="640"
# KİLİTLİ (kullanıcı kararı): eğitim batch=16 (yalnız MSI Gaming OC RTX 5070, 12 GB). K13 denemesinde 16 OOM'suz çalıştı (tepe ayrılan 10 850 MiB, %10 pay ölçütü sağlanmadı: ölçüt önbellek şişmesine duyarlı, bilgilendirici değil). Gerçek veriyle ilk eğitim pilotunda (A7) yeniden doğrulanır; OOM olursa belgedeki kural: bellek ölçütüyle en büyük değer.
TRAIN_BATCH="16"
TRAIN_EPOCHS="3"
TRAIN_SAVE_PERIOD="1"
TRAIN_NMS="False"
# Yapay deneme veri seti (.generated/, depoya girmez; gerçek hedef görünümünü temsil etmez)
TRAIN_VERI_TOHUM="1234"
TRAIN_VERI_EGITIM="128"
TRAIN_VERI_DOGRULAMA="32"
# Bilgi amaçlı ek batch değerleri (tek epoch)
TRAIN_BATCH_EK="8 24 32"
# Sığma kabulü (ölçülmüş eşik değil): tepe reserved belleği, toplam VRAM − başlangıç belleğinin altında ve en az bu yüzde pay bırakmalı
TRAIN_PAY_YUZDE="10"
# DataLoader işçi sayısı üst sınırı; gerçek değer çalışma anında .generated/hardware.env fiziksel çekirdek sayısıyla sınırlanır
TRAIN_WORKERS_MAX="8"

# ----------------------------------------------------------------------------------------------------------------------------------
# Sözleşme dosyaları ve koşu yapılandırması (M0a). Biçimler planlama/sozlesmeler.md'dedir; doğrulayıcı araclar/sozlesme_dogrula.py bu anahtarları okur.
# Kaynak etiketleri: [belge] = proje el kitabı/GŞÖA'da yazılı; [varsayım] = belgede yok, tasarım varsayımı (pilotlarda doğrulanır/değişebilir).
# Yerel ENU: orijin alanın merkezi, x = doğu, y = kuzey, z = yukarı (m).
# ----------------------------------------------------------------------------------------------------------------------------------
# Alan (sahne alanı). [varsayım] Belgede boyut yazılı değil; 300 m × 300 m, merkez orijinde.
ALAN_MERKEZ_X_M="0"
ALAN_MERKEZ_Y_M="0"
ALAN_GENISLIK_M="300"        # x (doğu) ekseni boyunca
ALAN_YUKSEKLIK_M="300"       # y (kuzey) ekseni boyunca
# Hedef merkezinin alan kenarına en az uzaklığı. [varsayım] Kenardaki hedefin kısmen alan dışına taşmaması için.
ALAN_KENAR_PAYI_M="5"
# Bölgeler. [belge] 3 çakışmayan bölge, araç başına bir bölge. [varsayım] 100 m × 300 m şeritler (x ekseninde yan yana).
ALAN_BOLGE_SAYISI="3"

# Rota. [belge] irtifa 30 m sabit; komşu şerit izleri en az 2 m örtüşür; iz genişliği w = 2·irtifa·tan(HFOV/2); HFOV = CAM_HFOV_RAD (kilitli).
ROTA_IRTIFA_M="30"
ROTA_ORTUSME_MIN_M="2"
# Geçici hız. [varsayım] Belgede sayısal değer yok ("pilotlarda belirlenir"); M1–M6'da geçici, M7 pilotunda belirlenir ve kilitlenir.
ROTA_HIZ_MS="5"

# Sahne. [belge] bölümler: eğitim/doğrulama/test; sınıflar: insan, enkaz; test sahnesinde 15 insan + 15 enkaz, merkezler arası ≥ 10 m.
SAHNE_BOLUMLER="egitim dogrulama test"
SAHNE_SINIFLAR="insan enkaz"
SAHNE_TEST_INSAN="15"
SAHNE_TEST_ENKAZ="15"
SAHNE_MERKEZ_MESAFE_TEST_M="10"
# Eğitim/doğrulama sahnesi: [varsayım] hedef merkezleri arası ≥ 6 m (hedefler birbirini örtmesin; enkaz yığını çapı ≈ 3–4 m), en çok 40 hedef.
SAHNE_MERKEZ_MESAFE_DIGER_M="6"
SAHNE_DIGER_HEDEF_MAKS="40"
# Görünüm varyantları. [belge] her sınıfın en az bir doku/renk varyantı yalnız test bölümünde kullanılır. [varsayım] varyant adları ve sayıları.
SAHNE_INSAN_VARYANTLARI="insan_a insan_b insan_c insan_test"
SAHNE_ENKAZ_VARYANTLARI="enkaz_a enkaz_b enkaz_c enkaz_test"
SAHNE_TEST_OZEL_INSAN="insan_test"
SAHNE_TEST_OZEL_ENKAZ="enkaz_test"
SAHNE_ZEMIN_VARYANTLARI="zemin_a zemin_b zemin_c"
# Güneş yüksekliği aralığı (derece). [varsayım] Işık tohumla değişir ([belge]); aralık tasarım varsayımı.
SAHNE_GUNES_YUKSEKLIK_MIN_DERECE="20"
SAHNE_GUNES_YUKSEKLIK_MAKS_DERECE="85"

# Kamera kalibrasyonu: kamera gövdeden aşağı bakar ([belge]); gövde çerçevesinde kameranın konumu: yük ölçümü sahnesindeki x500 + kamera düzeniyle
# aynı (0, 0, 0,10 m). [varsayım] Gerçek kalibrasyon yoktur; ideal iğne deliği modeli (bozulma yok).
KAL_KAMERA_KONUM_Z_M="0.10"

# Model. [belge] iki sınıf (insan, enkaz); giriş boyutu INF_IMGSZ, çıkarım ayarları INF_* (kilitli).
MODEL_SINIFLAR="insan enkaz"

# Koşu. [belge] 30 test sahnesi × 2 mimari; koşular eşzamanlı çalıştırılmaz; mimari çalışma sırası kaydedilen rastgele tohumla belirlenir.
KOSU_TEST_SAHNE_SAYISI="30"
KOSU_MIMARILER="ucta merkezi"
KOSU_ESZAMANLI="0"
# Sıra tohumu: [varsayım] değer tasarım varsayımıdır; ana deney öncesi kaydedilip kilitlenir.
KOSU_SIRA_TOHUMU="20260101"

# Koşu betiği (araclar/kosu.sh). Araç sayısı varsayılanı ve bekleme süreleri (saniye); donanıma bağlı değer değildir.
# KOSU_KAPANIS_SN: durdururken her süreç grubuna SIGTERM sonrası beklenen azami süre; dolarsa SIGKILL ve koşu üst verisinde "zorla kapatıldı".
KOSU_ARAC_SAYISI="1"
KOSU_GZ_HAZIR_SN="60"
KOSU_PX4_HAZIR_SN="90"
KOSU_KAPANIS_SN="30"

# px4_adapter (src/swarm_vehicle/swarm_vehicle/px4_adapter.py). Süreler saniye (gerçek zaman); donanıma bağlı değer değildir. [varsayım] hepsi.
# PX4A_BAGLAN_SN: mavsdk_server başlatma + PX4 bağlantısı + ilk telemetri için üst sınır. PX4A_KOMUT_SN: tek bir PX4 komutu/okuması için üst sınır.
# PX4A_HAZIR_SN: ev konumu ve "arm edilebilir" sağlık bilgisi için üst sınır. PX4A_KAPAT_SN: mavsdk_server'a SIGTERM sonrası bekleme (dolarsa SIGKILL).
# PX4A_KABUL_YARICAPI_M: her görev öğesinin kabul yarıçapı (m); PX4'ün öntanımlısı (NAV_ACC_RAD, 10 m) "son noktaya ulaşıldı" anını
# son noktadan 10 m uzağa kaydırır, bu yüzden öğe başına yazılır (PX4 parametresi DEĞİŞTİRİLMEZ).
PX4A_BAGLAN_SN="60"
PX4A_KOMUT_SN="20"
PX4A_HAZIR_SN="90"
PX4A_KAPAT_SN="5"
PX4A_KABUL_YARICAPI_M="2"
# PX4A_HAZIRLIK_SN: hazırlık evresi (kalkış + ilk noktaya gidiş) için üst sınır (gerçek saniye). PX4A_IRTIFA_TOLERANS_M: kalkışta ve ilk noktada irtifa kabul payı (m).
PX4A_HAZIRLIK_SN="240"
PX4A_IRTIFA_TOLERANS_M="1"

# Araç süreci (src/swarm_vehicle/swarm_vehicle/arac.py) ve ROS 2 konuları. Konu adları ve QoS belgede yazılı değildir: [varsayım] (planlama/sozlesmeler.md "ROS 2 konuları (taslak)").
# DURUM_YAYIN_HZ: [belge] her araç görev durumunu 2 Hz ile yayımlar. ARAC_KAPANIS_BEKLE_SN: TAMAMLANDI sonrası araç süreci kapanmadan önce durum yayımlamaya devam eder (dinleyiciler son durumu alsın), gerçek saniye.
# ARAC_SIM_SAAT_SN: araç süreci başlarken gz simülasyon saatinin ilk gelişi için üst sınır (gerçek saniye).
DURUM_YAYIN_HZ="2"
KONU_DURUM="/swarm/vehicle_state"
KONU_TARAMA_BASLAT="/swarm/scan_start"
KONU_TARAMA_BITIS="/swarm/scan_finished"
KONU_COMPLETE="/swarm/complete"
ARAC_KAPANIS_BEKLE_SN="3"
ARAC_SIM_SAAT_SN="30"

# Araç kamerası (B6) ve Gazebo damga bileşeni (B7). Kamera değerleri (CAM_*) yukarıdadır; kilitli olanlar değişmez. Araç modeli PX4 kaynağına dokunmadan araclar/kamera_uret.py ile
# bu değerlerden üretilir (SIM_MODEL: PX4'ün x500 + aşağı bakan kamera adı; havaçerçevesi bu adla eşleşir, model dosyası üretilen kopyadır).
# KAMERA_LINK / KAMERA_ALGILAYICI: üretilen modeldeki bağlantı ve algılayıcı adları; görüntü konusu /world/<dünya>/model/<model>_<örnek>/link/<bağlantı>/sensor/<algılayıcı>/image'dır.
# CAM_CLIP_*: kamera kırpma düzlemleri (m); 30 m irtifa için yeterli. [varsayım]
KAMERA_LINK="camera_link"
KAMERA_ALGILAYICI="camera"
CAM_CLIP_NEAR_M="0.1"
CAM_CLIP_FAR_M="200"
# Kare numaralandırma kipi: yalnız "izgara" uygulanır (n = CAM_RATE_HZ · t_sim). Yedek yol K9 kararıyla uygulanmaz; "yedek" seçilirse alıcı açık hata verir.
KARE_NUMARALAMA="izgara"
# Kamera alıcısı hata enjeksiyonu YALNIZ testler için ortam değişkeni KAMERA_ENJEKSIYON ile verilir (varsayılan kapalı); burada tanımlı değildir.

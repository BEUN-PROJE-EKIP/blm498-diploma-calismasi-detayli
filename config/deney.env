# config/deney.env — deney yapılandırmasının TEK KAYNAĞI (GŞÖA 5.1: "portlar, kimlikler ve deney ayarları tek yapılandırma dosyasında").
# Bash'ten `source` edilir. Ağ sabitleri yalnız burada tanımlanır; betiklerde ve kodda sabit yazılmaz.
# Bu sürümde yalnız ağ ve port bölümü vardır; ileride genişler.

# Ölçülen sürü ağı (loopback üzerinde ayrılmış blok)
SWARM_NET="10.10.0.0/24"
UAV1_ADDR="10.10.0.1"
UAV2_ADDR="10.10.0.2"
UAV3_ADDR="10.10.0.3"
GCS_ADDR="10.10.0.10"

# Fast DDS varsayılan keşif çoklu yayın grubu. Profille kapatılamıyor (alıcı yok, yalnız gönderim var); bu yüzden sınırlayıcıya
# (1:10) alınır ve keşif duyuruları da D sayacına girer. Belgedeki "çoklu yayın kullanılmaz" ifadesinden bilinen bir sapmadır.
DDS_MCAST_ADDR="239.255.0.1"

# Ortak kapasite sınırlayıcı (deneysel varsayım, sonuçlara bakılarak DEĞİŞTİRİLMEZ)
LINK_RATE_MBIT="25"

# Sınırlayıcı kuyruğu (FIFO, bayt). PROTOKOL PARAMETRESİ: el kitabındaki öngörülen başlangıç değeri (4 MiB, 25 Mbit/s'de ≈ 1,3 sn bekleme);
# kesin değer ayar pilotunda belirlenir ve ana deneyden önce kilitlenir.
LINK_QUEUE_BYTES="4194304"

# 127.0.0.1 üzerinde kalan iç bağlantılar (sınırlayıcıdan geçmez)
PX4_MAVLINK_PORTS="14540 14541 14542"
# gRPC portları Linux geçici (ephemeral) port aralığının (/proc/sys/net/ipv4/ip_local_port_range, öntanımlı 32768–60999) DIŞINDA seçilir: aralıktaki bir port
# başka bir sürecin giden bağlantısına kaynak port olarak atanmışsa mavsdk_server "Failed to bind server to port" ile başlayamaz (yerel deneyle doğrulandı).
MAVSDK_GRPC_PORTS="20051 20052 20053"

# Araç kimlikleri, ad alanları ve başlangıç konumları (araç sırası: 1. değer = 1. araç). Sıra, PX4_MAVLINK_PORTS ve MAVSDK_GRPC_PORTS ile aynıdır.
# Eşleme tablosu:
#   araç   MAV_SYS_ID   PX4→MAVSDK UDP   mavsdk_server gRPC   ROS 2 ad alanı   PX4 örneği (-i)   başlangıç konumu (x,y,z m)
#   1      1            14540            20051                /uav_1           0                 UAV_START_POSES 1. değer
#   2      2            14541            20052                /uav_2           1                 UAV_START_POSES 2. değer
#   3      3            14542            20053                /uav_3           2                 UAV_START_POSES 3. değer
# PX4 SITL kuralları: MAV_SYS_ID = örnek+1, UDP = 14540+örnek (PX4 üzerinde değiştirilmez; test bunu doğrular).
UAV_SYS_IDS="1 2 3"
UAV_NAMESPACES="uav_1 uav_2 uav_3"
UAV_START_POSES="0,0,0 3,0,0 6,0,0"

# Simülasyon dünyası ve araç modeli (başsız Gazebo, PX4 SITL)
SIM_WORLD="default"
SIM_MODEL="gz_x500_mono_cam_down"
# Kamerasız temel gövde (PX4'ün x500 modeli): K aşaması test ve ölçüm betikleri (arac_kimlik_testi, kamera_olcum_testi, yayim_olcum_testi) bunu kullanır; davranışları araç kamerası
# eklenmeden önceki doğrulanmış yapılandırmayla aynıdır. SIM_MODEL kameralı araç modelidir (koşu betiği ve araç süreci kullanır).
SIM_MODEL_TEMEL="gz_x500"

# Kamera ve deneme sahnesi (damga/sıra ve görüş açısı ölçümleri). Kamera araç gövdesine sabit ve aşağı bakan olacak (belge);
# deneme sahnesinde 30 m'de duran sabit kamera modeli kullanılır (araclar/kamera_olcum.py sahneyi bu değerlerden üretir).
CAM_WIDTH="640"
CAM_HEIGHT="480"
CAM_RATE_HZ="2"
CAM_ALT_M="30"
# SDF'deki yatay görüş açısı (rad): PX4'ün aşağı bakan kamera modeli (x500_mono_cam_down) ile aynı değer. Deneme sahnesinin girdisidir,
# protokol kilidi DEĞİL; kilitlenecek değer K10 ölçümüyle belirlenir.
CAM_SDF_HFOV_RAD="1.74"
# KİLİTLİ yatay görüş açısı (kullanıcı kararı): 65° (65°·π/180 = 1,134464 rad). Dayanak: aday açılarda (65°, 67,5°, 70°) yatan insanın dar kenarı
# ölçümü; 65°'de en kötü durum dar kenar 8,22 piksel (≥ 8 piksel kabul ölçütü). Sonuçlara bakılarak değiştirilmez. CAM_SDF_HFOV_RAD (1,74) yalnız
# ölçüm betiklerinde karşılaştırma tabanı olarak kalır; HFOV_ADAY_DERECE aday ölçümleri içindir.
CAM_HFOV_DEG="65"
CAM_HFOV_RAD="1.134464"
CAM_WORLD="kamera"
# Yerdeki hedefler: "kenar_m:x_m:y_m" (kamera 0,0 noktasının tam üstünde; görüntünün yatay ekseni dünya y eksenidir)
CAM_TARGETS="1:0:0 2:0:20 4:-10:-25"
# Çok kameralı yük denemesinde kameralar y ekseninde bu aralıkla dizilir
CAM_SPACING_M="100"
# Ölçüm süreleri (simülasyon saniyesi): K9 ≥ 600 kare için 2 Hz'de ≥ 300 sn; yük altı ≥ 120 sn
CAM_K9_SIM_SN="320"
CAM_YUK_SIM_SN="130"

# Yük ölçümü (üç araç + üç kamera + üç çıkarım işçisi) ve çıkarım ayarları. Çıkarım ayarları KİLİTLİDİR; sonuçlara bakılarak değiştirilmez.
INF_CONF="0.25"
INF_NMS="False"
INF_MAX_DET="300"
INF_IMGSZ="640"
INF_BATCH="1"
INF_PRECISION="fp32"
# Model ağırlıkları depoya girmez (.generated/models/, SHA-256 listesiyle izlenir)
INF_GPU_MODEL=".generated/models/yolo26l.pt"
INF_CPU_MODEL=".generated/models/yolo26s.pt"
# Süreler: gerçek hızda sürekli koşu (sim sn, ≥ 5 dk), doygunluk testi (gerçek sn)
YUK_SIM_SN="320"
YUK_DOYGUNLUK_SN="60"
# İşçi başına sınırlı kare kuyruğu (basit; taşma sayılır). Nihai kuyruk sınırı ayar pilotunda belirlenir.
YUK_KUYRUK="4"
# CPU yolu (ONNX Runtime): işçi başına mantıksal CPU sayısı = intra_op_num_threads
YUK_CPU_ISCI_CPU="2"
# CPU yolu (ONNX Runtime) gerçek hızda sürekli koşu süresi (sim sn)
YUK_CPU_SIM_SN="130"

# Aday yatay görüş açıları (derece) ve hedef boyutu ölçümü (GŞÖA 5.2). Kabul ölçütü ölçülmüş değer değildir: yatan insanın dar kenarı ≥ OLC_DAR_KENAR_PX piksel.
HFOV_ADAY_DERECE="65 67.5 70"
OLC_DAR_KENAR_PX="8"
# Yatan insan (ölçüm temsili, kalıcı model değil): uzun kenar:dar kenar:kalınlık (m); yönelim görüntü yatay eksenine göre (derece)
INSAN_BOYUT="1.7:0.5:0.25"
INSAN_YONELIM="0 45 90"
# Enkaz yığını (ölçüm temsili): kutu sayısı, yığın çapı (m), en büyük kutu yüksekliği (m)
ENKAZ_KUTU_SAYISI="6"
ENKAZ_CAP_M="3"
ENKAZ_YUKSEKLIK_M="0.9"
# HFOV kalibrasyon levhaları (kenar_m:görüntü_yarı_genişliğinin_oranı_x:oranı_y); konumlar her adayın görüş alanına göre ölçeklenir
KALIB_KARELER="1:-0.5:-0.5 2:-0.5:0.5 4:0.4:0"

# Eğitim bellek denemesi (belge: 50 epoch, batch=16, 640 piksel, nms=False, save_period=1). Bu ayarlar eğitim DENEMESİ içindir; gerçek eğitim ayrı bir iştir.
TRAIN_MODEL=".generated/models/yolo26l.pt"
TRAIN_IMGSZ="640"
# KİLİTLİ (kullanıcı kararı): eğitim batch=16 (yalnız MSI Gaming OC RTX 5070, 12 GB). K13 denemesinde 16 OOM'suz çalıştı (tepe ayrılan 10 850 MiB, %10 pay ölçütü sağlanmadı: ölçüt önbellek şişmesine duyarlı, bilgilendirici değil). Gerçek veriyle ilk eğitim pilotunda (A7) yeniden doğrulanır; OOM olursa belgedeki kural: bellek ölçütüyle en büyük değer.
TRAIN_BATCH="16"
TRAIN_EPOCHS="3"
TRAIN_SAVE_PERIOD="1"
TRAIN_NMS="False"
# Yapay deneme veri seti (.generated/, depoya girmez; gerçek hedef görünümünü temsil etmez)
TRAIN_VERI_TOHUM="1234"
TRAIN_VERI_EGITIM="128"
TRAIN_VERI_DOGRULAMA="32"
# Bilgi amaçlı ek batch değerleri (tek epoch)
TRAIN_BATCH_EK="8 24 32"
# Sığma kabulü (ölçülmüş eşik değil): tepe reserved belleği, toplam VRAM − başlangıç belleğinin altında ve en az bu yüzde pay bırakmalı
TRAIN_PAY_YUZDE="10"
# DataLoader işçi sayısı üst sınırı; gerçek değer çalışma anında .generated/hardware.env fiziksel çekirdek sayısıyla sınırlanır
TRAIN_WORKERS_MAX="8"

# ----------------------------------------------------------------------------------------------------------------------------------
# Sözleşme dosyaları ve koşu yapılandırması (M0a). Biçimler planlama/sozlesmeler.md'dedir; doğrulayıcı araclar/sozlesme_dogrula.py bu anahtarları okur.
# Kaynak etiketleri: [belge] = proje el kitabı/GŞÖA'da yazılı; [varsayım] = belgede yok, tasarım varsayımı (pilotlarda doğrulanır/değişebilir).
# Yerel ENU: orijin alanın merkezi, x = doğu, y = kuzey, z = yukarı (m).
# ----------------------------------------------------------------------------------------------------------------------------------
# Alan (sahne alanı). KİLİTLİ (kullanıcı kararı; M1 1.7 mini pilotu, 2026-11-14; sonuçlara bakılarak değiştirilmez; hız M7'de): belgede boyut yazılı değildir; 300 m × 300 m, merkez orijinde.
# Dayanak: üç araç tam rotayı uçtu, her bölgede boş nokta oranı ≤ %0,023, komşu şerit örtüşmesi en az 7,0 m (planlanan ≥ 2 m), bölge taşması 0 m.
ALAN_MERKEZ_X_M="0"
ALAN_MERKEZ_Y_M="0"
ALAN_GENISLIK_M="300"        # x (doğu) ekseni boyunca
ALAN_YUKSEKLIK_M="300"       # y (kuzey) ekseni boyunca
# Hedef merkezinin alan kenarına en az uzaklığı. [varsayım] Kenardaki hedefin kısmen alan dışına taşmaması için.
ALAN_KENAR_PAYI_M="5"
# Bölgeler. [belge] 3 çakışmayan bölge, araç başına bir bölge. KİLİTLİ (M1 1.7 mini pilotu, 2026-11-14; sonuçlara bakılarak değiştirilmez): 100 m × 300 m şeritler (x ekseninde yan yana).
ALAN_BOLGE_SAYISI="3"

# Rota. [belge] irtifa 30 m sabit; komşu şerit izleri en az 2 m örtüşür; iz genişliği w = 2·irtifa·tan(HFOV/2); HFOV = CAM_HFOV_RAD (kilitli).
ROTA_IRTIFA_M="30"
ROTA_ORTUSME_MIN_M="2"
# Geçici hız. [varsayım] Belgede sayısal değer yok ("pilotlarda belirlenir"); M1–M6'da geçici, M7 pilotunda belirlenir ve kilitlenir.
ROTA_HIZ_MS="5"

# Sahne. [belge] bölümler: eğitim/doğrulama/test; sınıflar: insan, enkaz; test sahnesinde 15 insan + 15 enkaz, merkezler arası ≥ 10 m.
SAHNE_BOLUMLER="egitim dogrulama test"
SAHNE_SINIFLAR="insan enkaz"
SAHNE_TEST_INSAN="15"
SAHNE_TEST_ENKAZ="15"
SAHNE_MERKEZ_MESAFE_TEST_M="10"
# Eğitim/doğrulama sahnesi: [varsayım] hedef merkezleri arası ≥ 6 m (hedefler birbirini örtmesin; enkaz yığını çapı ≈ 3–4 m), en çok 40 hedef.
SAHNE_MERKEZ_MESAFE_DIGER_M="6"
SAHNE_DIGER_HEDEF_MAKS="40"
# Görünüm varyantları. [belge] her sınıfın en az bir doku/renk varyantı yalnız test bölümünde kullanılır. [varsayım] varyant adları ve sayıları.
SAHNE_INSAN_VARYANTLARI="insan_a insan_b insan_c insan_test"
SAHNE_ENKAZ_VARYANTLARI="enkaz_a enkaz_b enkaz_c enkaz_test"
SAHNE_TEST_OZEL_INSAN="insan_test"
SAHNE_TEST_OZEL_ENKAZ="enkaz_test"
SAHNE_ZEMIN_VARYANTLARI="zemin_a zemin_b zemin_c"
# Güneş yüksekliği aralığı (derece). [varsayım] Işık tohumla değişir ([belge]); aralık tasarım varsayımı.
SAHNE_GUNES_YUKSEKLIK_MIN_DERECE="20"
SAHNE_GUNES_YUKSEKLIK_MAKS_DERECE="85"

# Kamera kalibrasyonu: kamera gövdeden aşağı bakar ([belge]); gövde çerçevesinde kameranın konumu: yük ölçümü sahnesindeki x500 + kamera düzeniyle
# aynı (0, 0, 0,10 m). [varsayım] Gerçek kalibrasyon yoktur; ideal iğne deliği modeli (bozulma yok).
KAL_KAMERA_KONUM_Z_M="0.10"

# Model. [belge] iki sınıf (insan, enkaz); giriş boyutu INF_IMGSZ, çıkarım ayarları INF_* (kilitli).
MODEL_SINIFLAR="insan enkaz"
# Hedef birleştirme aralığı (m), KİLİTLİ [belge, FR-19]: aynı sınıftaki bir tespit, mevcut adayın sabit ilk konumuna en fazla bu kadar uzaksa o adaya eklenir. Hedef birleştirme (B15) ve nihai rapor doğrulayıcısı bu anahtardan okur.
BIRLESTIRME_ARALIK_M="2.5"
# Değerlendirme eşleştirme eşiği (m), KİLİTLİ [belge, FR-28]: nihai rapor ile gerçek hedef, doğru sınıf ve en fazla bu kadar yatay uzaklık şartıyla
# Macar algoritmasıyla bire bir atanır (TP). Değerlendirme yazılımı (B18, araclar/degerlendirme/eslestirme.py) bu anahtardan okur.
DEGERLENDIRME_ESLESME_ESIK_M="5"

# Koşu. [belge] 30 test sahnesi × 2 mimari; koşular eşzamanlı çalıştırılmaz; mimari çalışma sırası kaydedilen rastgele tohumla belirlenir.
KOSU_TEST_SAHNE_SAYISI="30"
KOSU_MIMARILER="ucta merkezi"
KOSU_ESZAMANLI="0"
# Sıra tohumu: [varsayım] değer tasarım varsayımıdır; ana deney öncesi kaydedilip kilitlenir.
KOSU_SIRA_TOHUMU="20260101"

# Koşu betiği (araclar/kosu.sh). Araç sayısı varsayılanı ve bekleme süreleri (saniye); donanıma bağlı değer değildir.
# KOSU_KAPANIS_SN: durdururken her süreç grubuna SIGTERM sonrası beklenen azami süre; dolarsa SIGKILL ve koşu üst verisinde "zorla kapatıldı".
KOSU_ARAC_SAYISI="1"
KOSU_GZ_HAZIR_SN="60"
KOSU_PX4_HAZIR_SN="90"
KOSU_KAPANIS_SN="30"

# px4_adapter (src/swarm_vehicle/swarm_vehicle/px4_adapter.py). Süreler saniye (gerçek zaman); donanıma bağlı değer değildir. [varsayım] hepsi.
# PX4A_BAGLAN_SN: mavsdk_server başlatma + PX4 bağlantısı + ilk telemetri için üst sınır. PX4A_KOMUT_SN: tek bir PX4 komutu/okuması için üst sınır.
# PX4A_HAZIR_SN: ev konumu ve "arm edilebilir" sağlık bilgisi için üst sınır. PX4A_KAPAT_SN: mavsdk_server'a SIGTERM sonrası bekleme (dolarsa SIGKILL).
# PX4A_KABUL_YARICAPI_M: her görev öğesinin kabul yarıçapı (m); PX4'ün öntanımlısı (NAV_ACC_RAD, 10 m) "son noktaya ulaşıldı" anını
# son noktadan 10 m uzağa kaydırır, bu yüzden öğe başına yazılır (NAV_ACC_RAD gibi gezinme parametreleri DEĞİŞTİRİLMEZ; yalnız hazırlık evresinin kalkış irtifası
# MIS_TAKEOFF_ALT = ROTA_IRTIFA_M olarak yazılır: planlama/kararlar.md "hazırlık evresi ve kalkış irtifası").
# PX4A_HEARTBEAT_SN: bağlantıdan sonra HEARTBEAT kaynak kimliğinin okunması için bekleme üst sınırı (gerçek sn). PX4A_BASLAT_TOLERANS_M: görev başlatmadan önce aracın ilk noktada
# sayılması için kabul yarıçapına ve irtifa payına eklenen ek pay (m); hazırlık bitişi ile başlatma arasındaki küçük kaymayı karşılar.
PX4A_BAGLAN_SN="60"
PX4A_KOMUT_SN="20"
PX4A_HAZIR_SN="90"
PX4A_KAPAT_SN="5"
PX4A_KABUL_YARICAPI_M="2"
PX4A_HEARTBEAT_SN="5"
PX4A_BASLAT_TOLERANS_M="1"
# PX4A_HAZIRLIK_SN: hazırlık evresi (kalkış + ilk noktaya gidiş) için üst sınır (gerçek saniye). PX4A_IRTIFA_TOLERANS_M: kalkışta ve ilk noktada irtifa kabul payı (m).
PX4A_HAZIRLIK_SN="240"
PX4A_IRTIFA_TOLERANS_M="1"
# PX4A_YON_*: hazırlık evresinin son adımı (t0'dan önce): araç ilk rota noktasında konum tutarak ilk tarama doğrusunun yönüne döner (yön rotadan hesaplanır; görev öğesine yaw
# yazılmaz). Biter: |yaw farkı| <= PX4A_YON_ESIK_DERECE ve yatay hız <= PX4A_YON_HIZ_ESIK_MS. PX4A_YON_SN: bu adım için üst sınır (gerçek saniye; aşılırsa hazırlık hatası). [varsayım] hepsi.
PX4A_YON_ESIK_DERECE="3"
PX4A_YON_HIZ_ESIK_MS="0.3"
PX4A_YON_SN="30"

# Poz tamponu ve kare–poz enterpolasyonu (src/swarm_vehicle/swarm_vehicle/poz_tamponu.py; iki mod için ortak kural).
# POZ_ARALIK_SINIR_MS: kareyi çevreleyen iki telemetri örneği arasındaki en büyük süre (ms); aşılırsa o karenin tespitleri konumsuz kaydedilir. [belge: öngörülen değer 100 ms; protokolde kilitlenir]
# POZ_BEKLE_SN: kare anı en son örnekten sonraysa sonraki örnek için en çok bekleme (gerçek sn; bekleme ölçüme dahildir). [varsayım] 0,25 sn: sınırın (0,1 sn) iki katından fazla ve 2 Hz kare aralığının (0,5 sn) yarısı.
# POZ_TAMPON_SN: tamponun saklama penceresi (en yeni örnekten geriye, kaynak sn). [varsayım] 60 sn: kare işleme gecikmesinden (çıkarım ~ms, kuyruk sınırlı) çok büyük; ~50 Hz ile birkaç bin örnek.
POZ_ARALIK_SINIR_MS="100"
POZ_BEKLE_SN="0.25"
POZ_TAMPON_SN="60"

# Konum hesaplayıcı (src/swarm_vehicle/swarm_vehicle/konum_hesap.py; iki mod için ortak kural, FR-17, FR-18).
# ZEMIN_Z_M: kutu merkezinden çıkan ışının kesiştirildiği bilinen düz zemin düzleminin ortak yerel ENU'daki yüksekliği (m; z yukarı). [belge: bilinen düz zemin; değer varsayım] Dünya dosyasındaki zemin düzlemi z = 0'dadır.
# Test anahtarı YALNIZ ortam değişkeni (varsayılan kapalı): KONUM_TEST_SAHTE=`x1,y1,x2,y2[;x1,y1,x2,y2...]` çıkarım işçisinin başarılı yanıtına bu sabit piksel kutulu sahte tespitler ekler (gerçek tespit yolu ve sınıf eşlemesi atlanmaz).
ZEMIN_Z_M="0"

# Merkezi mod (B12): araç başına TCP görüntü kanalı (src/swarm_vehicle/swarm_vehicle/goruntu_kanali.py, src/swarm_gcs/swarm_gcs/merkezi_alici.py; ileti biçimi planlama/sozlesmeler.md §10.3).
# MERKEZI_TCP_PORT_TABAN: yer istasyonunun GCS_ADDR üzerindeki dinleme port tabanı (araç sırası k için taban + k − 1). [varsayım] (SENTETIK_YUK_PORT_TABAN'dan ayrı). Sabit dinleme portları Linux geçici port aralığının (32768–60999) dışında tutulur.
# MERKEZI_BAGLAN_SN: araç kanalının bağlanma denemesi üst sınırı (gerçek sn; bağlanamazsa araç açık hata ile çıkar). MERKEZI_BOSALT_SN: TAMAMLANDI sonrası gönderim kuyruğunun boşalması için üst sınır (gerçek sn).
# MERKEZI_KUYRUK_KAYIT_SN: gönderim kuyruğu derinliği kaydı aralığı (gerçek sn). MERKEZI_YUK_MAKS_BAYT: alıcının kabul ettiği en büyük yük uzunluğu (bellek koruması; 640×480×3 = 921 600 bayt). [varsayım] hepsi.
MERKEZI_TCP_PORT_TABAN="27200"
MERKEZI_BAGLAN_SN="60"
MERKEZI_BOSALT_SN="60"
MERKEZI_KUYRUK_KAYIT_SN="1"
MERKEZI_YUK_MAKS_BAYT="16777216"

# Araç süreci (src/swarm_vehicle/swarm_vehicle/arac.py) ve ROS 2 konuları. Konu adları ve QoS belgede yazılı değildir: [varsayım] (planlama/sozlesmeler.md "ROS 2 konuları (taslak)").
# DURUM_YAYIN_HZ: [belge] her araç görev durumunu 2 Hz ile yayımlar. ARAC_KAPANIS_BEKLE_SN: TAMAMLANDI sonrası araç süreci kapanmadan önce durum yayımlamaya devam eder (dinleyiciler son durumu alsın), gerçek saniye.
# ARAC_SIM_SAAT_SN: araç süreci başlarken gz simülasyon saatinin ilk gelişi için üst sınır (gerçek saniye).
DURUM_YAYIN_HZ="2"
KONU_DURUM="/swarm/vehicle_state"
KONU_TARAMA_BASLAT="/swarm/scan_start"
KONU_TARAMA_BITIS="/swarm/scan_finished"
KONU_COMPLETE="/swarm/complete"
# KONU_GOREV: Mission iletileri (yer istasyonu → araçlar; tek ortak konu, ileti vehicle_id taşır, araç kendisininkini süzer): reliable, transient_local, keep_last 10 [varsayım].
# KONU_KOMUT: araç komut konusu, araç ad alanına GÖRELİ ("command" → /uav_N/command): reliable, volatile, keep_last 10; KONU_KOMUT_ONAY: ortak onay konusu (araç → yer istasyonu): reliable, transient_local, keep_last 20 [varsayım].
# Belge komut TÜRLERİNİ tanımlamaz; deneyde komut gönderilmez (komut yolu iskeleti: planlama/kararlar.md). GOREV_BEKLE_SN: aracın kendi Mission'ını bekleme üst sınırı (gerçek sn; aşılırsa araç açık hata ile çıkar).
# GCS_UST_SN: yer istasyonu görev koordinatörü üst süre sınırı (gerçek sn; H zaman aşımı DEĞİL, M7'de belirlenir; aşılırsa COMPLETE yayımlanmaz, çıkış ≠ 0). IZLEME_BAYAT_SN: bir araçtan bu kadar sn durum gelmezse izleme uyarısı;
# IZLEME_OZET_SN: izleme kaydında periyodik özet aralığı (gerçek sn). Test anahtarları YALNIZ ortam değişkeni: GOREV_ENJEKSIYON (yer istasyonu: sapma=<araç>), ARAC_DURUM_SUS (araç: [<araç>:]<başlangıç_sn>:<süre_sn>, tarama başından), ARAC_TEST_CIKIS (araç: <araç kimliği>:bariyer = BARIYER_BEKLE'ye geçince, t0'dan önce; <araç kimliği>:tarama:<sn> = tarama başladıktan sn gerçek saniye sonra; o araç süreci çökme gibi çıkış 70 ile çıkar), GCS_UST_SN (aynı adlı ortam değişkeni yapılandırmayı yalnız o çağrı için geçersiz kılar).
KONU_GOREV="/swarm/mission"
KONU_KOMUT="command"
KONU_KOMUT_ONAY="/gcs/command_ack"
GOREV_BEKLE_SN="900"
GCS_UST_SN="1800"
IZLEME_BAYAT_SN="5"
IZLEME_OZET_SN="10"
# SENTETIK_YUK_PORT_TABAN: araclar/sentetik_yuk.py (YALNIZ test aracı; merkezi modun ağ yükünü taklit eder, B12 değildir) alıcılarının GCS_ADDR üzerindeki TCP port tabanı (araç k için taban + k - 1).
SENTETIK_YUK_PORT_TABAN="27100"
ARAC_KAPANIS_BEKLE_SN="3"
ARAC_SIM_SAAT_SN="30"
# Kare sonucu konusu (uçta mod, B11) [varsayım: konu adı ve QoS belgede yazılı değil; yalnız "reliable" belgedir]. Tek ortak konu: üç araç yayımlar, ileti vehicle_id taşır; yer istasyonu abone olur.
# QOS_KARE_SONUC_*: GUVENILIRLIK reliable [belge]. GECMIS=keep_last + DERINLIK=1000: bir koşuda araç başına en çok ~570 görev karesi (300 m alanda 382-383; 360 m adayda 563) olduğundan derinlik hiçbir onaysız
# iletiyi düşürmez ve yayım kare işleme iş parçacığını bloke etmez (keep_all kaynak sınırına dayanınca yayımı bloke edebilir). DAYANIKLILIK=transient_local: yer istasyonu yayımcıyı sonradan keşfetse bile (keşif sırası belirsiz)
# yayımlanmış iletiler teslim edilir; eski koşunun iletisi sorun değil (araç süreçleri koşu başına yeni başlar). KARE_SONUC_ACK_SN: araç TAMAMLANDI'dan sonra bütün iletilerin abonelerce onaylanmasını bekleme üst sınırı (gerçek sn).
# KARE_SONUC_ESLESME_SN: deneme koordinatörünün bütün araç yayımcılarıyla eşleşmeyi bekleme üst sınırı (gerçek sn). Hata/gecikme enjeksiyonu YALNIZ testler için ortam değişkeni KARE_SONUC_ENJEKSIYON ile verilir (varsayılan kapalı).
KONU_KARE_SONUC="/swarm/frame_result"
QOS_KARE_SONUC_GUVENILIRLIK="reliable"
QOS_KARE_SONUC_GECMIS="keep_last"
QOS_KARE_SONUC_DERINLIK="1000"
QOS_KARE_SONUC_DAYANIKLILIK="transient_local"
KARE_SONUC_ACK_SN="30"
KARE_SONUC_ESLESME_SN="120"

# Çıkarım işçisi (B9) ve kare sonucu (B10). Çıkarım ayarları (INF_*) yukarıda KİLİTLİDİR; işçi bunları yalnız buradan okur. Ağırlık İNDİRİLMEZ (.generated/models; YOLO_OFFLINE).
# ISCI_ARKA_UC: gpu (PyTorch + CUDA, YOLO26L; kilitli deney yolu) | cpu (B planı: ONNX Runtime, yalnız yapı uyumu için; deneylerde kullanılmaz). ISCI_CPU_ONNX: cpu arka ucu için NMS'siz ONNX.
# ISCI_MANTIKSAL_CPU: işçiye verilen, aynı fiziksel çekirdeğe ait mantıksal CPU sayısı [belge: iki]. ISCI_CPU_SABITLE: 1 ise işçi çalışma anında okunan topolojiye göre bu CPU'lara sabitlenir
# (araç sırasına göre çekirdek çifti; sabit CPU numarası yoktur); diğer süreçlerin bu kümeden çıkarılması ayrı iştir.
# ISCI_ISINMA_KARE: hazırlıkta yapılan ısınma çıkarımı sayısı. ISCI_HAZIR_SN: işçinin modeli yükleyip ısınmayı bitirmesi için üst sınır (gerçek sn; aşılırsa araç HAZIR'a geçmez).
# ISCI_KARE_ZAMAN_ASIMI_SN: tek karenin işçide işlenmesi için üst sınır (gerçek sn; aşılırsa kare işlem hatası olur, işçi yeniden başlatılır).
# ISCI_YENIDEN_BASLAT_MAKS: işçi ölürse ya da zaman aşımı olursa yeniden başlatma sayısı üst sınırı [varsayım: belgede işçi ölümü kuralı yok]; aşılırsa kalan kareler işlem hatası olur.
# ISCI_KAPANIS_BEKLE_SN: COMPLETE sonrası kuyruğun boşalması için üst sınır (gerçek sn). ISCI_KAYNAK_SN: işçi kaynak (GPU kullanımı/belleği, ana bellek) örnekleme aralığı (gerçek sn).
# MODEL_ESLEME_COCO: COCO ön eğitimli ağırlıkla yalnız M1 boru hattı sınaması için "model_sınıf_adı=proje_sınıfı" eşlemesi [varsayım]; proje modelinin sınıf adları MODEL_SINIFLAR ile aynıdır ve birebir eşlenir.
# İşçi hata enjeksiyonu YALNIZ testler için ortam değişkeni ISCI_ENJEKSIYON ile verilir (varsayılan kapalı); burada tanımlı değildir.
ISCI_ARKA_UC="gpu"
ISCI_CPU_ONNX=".generated/models/yolo26s.onnx"
ISCI_MANTIKSAL_CPU="2"
ISCI_CPU_SABITLE="1"
ISCI_ISINMA_KARE="5"
ISCI_HAZIR_SN="300"
ISCI_KARE_ZAMAN_ASIMI_SN="30"
ISCI_YENIDEN_BASLAT_MAKS="3"
ISCI_KAPANIS_BEKLE_SN="60"
ISCI_KAYNAK_SN="1"
MODEL_ESLEME_COCO="person=insan"

# Araç kamerası (B6) ve Gazebo damga bileşeni (B7). Kamera değerleri (CAM_*) yukarıdadır; kilitli olanlar değişmez. Araç modeli PX4 kaynağına dokunmadan araclar/kamera_uret.py ile
# bu değerlerden üretilir (SIM_MODEL: PX4'ün x500 + aşağı bakan kamera adı; havaçerçevesi bu adla eşleşir, model dosyası üretilen kopyadır).
# KAMERA_LINK / KAMERA_ALGILAYICI: üretilen modeldeki bağlantı ve algılayıcı adları; görüntü konusu /world/<dünya>/model/<model>_<örnek>/link/<bağlantı>/sensor/<algılayıcı>/image'dır.
# CAM_CLIP_*: kamera kırpma düzlemleri (m); 30 m irtifa için yeterli. [varsayım]
KAMERA_LINK="camera_link"
KAMERA_ALGILAYICI="camera"
CAM_CLIP_NEAR_M="0.1"
CAM_CLIP_FAR_M="200"
# Kare numaralandırma kipi: yalnız "izgara" uygulanır (n = CAM_RATE_HZ · t_sim). Yedek yol K9 kararıyla uygulanmaz; "yedek" seçilirse alıcı açık hata verir.
KARE_NUMARALAMA="izgara"
# Kamera alıcısı hata enjeksiyonu YALNIZ testler için ortam değişkeni KAMERA_ENJEKSIYON ile verilir (varsayılan kapalı); burada tanımlı değildir.

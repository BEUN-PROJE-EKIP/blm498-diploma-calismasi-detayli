#!/usr/bin/env bash
# .githooks/pre-push — main dalına DOĞRUDAN push'u engeller (isteğe bağlı güvenlik).
# Açmak için (her klon için bir kez):  git config core.hooksPath .githooks
# Dal göndermek serbesttir:             git push -u origin ad/konu
# Proje sahibi gerekirse geçici izin verir:  MAIN_PUSH_IZNI=1 git push origin main
while read -r _yerel_ref _yerel_sha uzak_ref _uzak_sha; do
    if [[ "$uzak_ref" == "refs/heads/main" && "${MAIN_PUSH_IZNI:-0}" != "1" ]]; then
        echo "(-) main dalına doğrudan push engellendi." >&2
        echo "(i) Kendi dalını gönder:  git push -u origin ad/konu  ve GitHub'da Pull Request aç." >&2
        exit 1
    fi
done
exit 0
